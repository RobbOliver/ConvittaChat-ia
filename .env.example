# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Get this at https://openrouter.ai/keys. Use ONE of the two below:
# - OPENROUTER_API_KEY: a single key, simplest setup.
# - OPENROUTER_API_KEYS: two or more keys (different OpenRouter accounts), comma-separated, tried
#   in order — automatic failover when one hits its free-tier daily limit or errors out. Takes
#   priority over OPENROUTER_API_KEY when both are set.
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=

# Any model id OpenRouter serves — https://openrouter.ai/models
# Pinned to google/gemini-2.5-flash-lite, chosen 2026-08-14 after a real 75-call benchmark against
# 5 candidates (gpt-4.1-nano, gemini-2.5-flash-lite, openrouter/free, deepseek-v4-flash-0731,
# ling-3.0-flash) run against production prompt-building/parsing code: 93% success rate, fastest
# and most consistent latency, and the best "custo efetivo" (cost ÷ success rate) of the group.
# "openrouter/free" (OpenRouter's own router across whatever free models happen to be up) was tried
# first and reinstated once after a single pinned free model's upstream pool went flaky — but the
# benchmark showed openrouter/free itself is the least consistent of all 5 (10 different underlying
# models across 15 calls). Swap this only after re-running the benchmark script in
# ia/../scratchpad — do not swap based on price alone, see the ling-3.0-flash/deepseek findings.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Shown to OpenRouter for attribution/rankings — not sensitive, just identifies this app.
APP_URL=https://convittachat-frontend.onrender.com
APP_NAME=Convitta Chat IA

# development locally; set to "production" on Render. When production, SERVICE_API_KEY below
# becomes required — the server refuses to start without it, so /chat is never accidentally public.
NODE_ENV=development

# Render sets this automatically in production — only needed locally, and only if 3001 is taken.
PORT=3001

# Shared secret the caller must send as the "x-api-key" header to use POST /chat. Generate a long
# random value, e.g.: openssl rand -hex 32
# Required in production. Left blank locally, /chat has no auth (fine for local testing only).
SERVICE_API_KEY=
