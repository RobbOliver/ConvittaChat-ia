# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Get this at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id OpenRouter serves — https://openrouter.ai/models
# "openrouter/free" is OpenRouter's own router across free models (zero cost, picks one at
# random from whatever's available) — swap for a specific paid model id if quality matters more
# than cost.
OPENROUTER_MODEL=openrouter/free

# Shown to OpenRouter for attribution/rankings — not sensitive, just identifies this app.
APP_URL=https://convittachat-frontend.onrender.com
APP_NAME=Convitta Chat IA

# development locally; set to "production" on Render. When production, SERVICE_API_KEY below
# becomes required — the server refuses to start without it, so /chat is never accidentally public.
NODE_ENV=development

# Render sets this automatically in production — only needed locally, and only if 3001 is taken.
PORT=3001

# Shared secret the caller must send as the "x-api-key" header to use POST /chat. Generate a long
# random value, e.g.: openssl rand -hex 32
# Required in production. Left blank locally, /chat has no auth (fine for local testing only).
SERVICE_API_KEY=
