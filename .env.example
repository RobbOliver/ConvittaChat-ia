# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Get this at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id OpenRouter serves — https://openrouter.ai/models
# Defaults to a fast, inexpensive, instruction-following model; swap freely.
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Shown to OpenRouter for attribution/rankings — not sensitive, just identifies this app.
APP_URL=https://convittachat-frontend.onrender.com
APP_NAME=Convitta Chat IA
